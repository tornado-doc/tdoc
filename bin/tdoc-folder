#!/usr/bin/env bash
# tdoc-folder — make folders and file docs into them, in My docs or a team.
#
# Same rules as the web: My docs folders hold your own docs; a team's folders
# are shared by its members (any member makes one; its maker or an admin
# renames/deletes it) and a team doc is filed by its author or an admin.
# Uses the hosted Bearer in ~/.tdoc/published.json.
#
# Usage:
#   tdoc-folder list [--team <name|id>] [--json]
#   tdoc-folder create <name> [--parent <folder>] [--team <t>]   # existing name: returns it
#   tdoc-folder add <slug>... --folder <folder> [--team <t>] [--create] [--parent <folder>]
#   tdoc-folder remove <slug>... [--team <t>]                    # back to the top level
#   tdoc-folder rename <folder> <new name> [--team <t>]
#   tdoc-folder delete <folder> [--team <t>]                     # folder + its docs go to Trash (30 days)
#   tdoc-folder share <folder> [--visibility unlisted|private|public] [--team <t>]  # prints the link
#   tdoc-folder unshare <folder> [--team <t>]                    # the link stops working
#   tdoc-folder move-to-team <folder> --team <t>   # a My docs folder, subfolders and docs, into a team
#   <folder> is an id (f_…), a path ("Reports/Daily"), or a name unique in that space.
#   A team doc must be in the team first: tdoc-move --team <t> --folder <f> <slug>.
#   A share link lists the folder's docs; each doc keeps its own access (a
#   team-only doc stays hidden from people outside the team). private = you
#   (in a team: its members) plus invitees; share again keeps the current
#   setting unless --visibility is given (a first share is unlisted).
#   move-to-team makes the same folders in the team (merging into same-named
#   ones), moves your docs in, and removes the emptied My docs folders.
#   tdoc-folder --help
set -euo pipefail
TDOC_BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$TDOC_BIN_DIR/lib/json.sh"

usage() { sed -n '9,26p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
case "${1:-}" in
  -h|--help|help) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  list|ls|create|mkdir|add|remove|rename|delete|rm|share|unshare|move-to-team) CMD="$1"; shift ;;
  *) usage ;;
esac

TEAM=""; FOLDER=""; PARENT=""; VISIBILITY=""; CREATE=0; AS_JSON=0; ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --team) TEAM="${2:-}"; [ -n "$TEAM" ] || { echo "--team needs a name or id" >&2; exit 2; }; shift 2 ;;
    --team=*) TEAM="${1#--team=}"; shift ;;
    --folder) FOLDER="${2:-}"; [ -n "$FOLDER" ] || { echo "--folder needs a name, path or id" >&2; exit 2; }; shift 2 ;;
    --folder=*) FOLDER="${1#--folder=}"; shift ;;
    --parent) PARENT="${2:-}"; [ -n "$PARENT" ] || { echo "--parent needs a folder" >&2; exit 2; }; shift 2 ;;
    --parent=*) PARENT="${1#--parent=}"; shift ;;
    --visibility) VISIBILITY="${2:-}"; [ -n "$VISIBILITY" ] || { echo "--visibility needs unlisted, private or public" >&2; exit 2; }; shift 2 ;;
    --visibility=*) VISIBILITY="${1#--visibility=}"; shift ;;
    --create) CREATE=1; shift ;;
    --json) AS_JSON=1; shift ;;
    -h|--help) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown arg: $1" >&2; exit 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

CONFIG_FILE="$HOME/.tdoc/published.json"
TOKEN="$( [ -f "$CONFIG_FILE" ] && json_file_get "$CONFIG_FILE" upload_token || true)"
BASE="$( [ -f "$CONFIG_FILE" ] && json_file_get "$CONFIG_FILE" base || true)"
if [ -z "$TOKEN" ] || [ -z "$BASE" ]; then
  echo "[tdoc] not signed in to hosted tdoc — run 'tdoc-publish --signin-only' first." >&2
  exit 1
fi
BASE="${BASE%/}"

# api <METHOD> <path> [json body] — prints the body; fails on non-2xx or an
# "error" key, printing a readable reason. An error named in $API_SOFT_ERR
# returns 4 silently, so the caller can retry it.
API_SOFT_ERR=""
api() {
  local resp http body err
  resp="$(curl -sS --connect-timeout 10 --max-time 30 -w $'\n%{http_code}' -X "$1" "$BASE$2" \
    -H "Authorization: Bearer $TOKEN" -H "Accept: application/json" \
    ${3:+-H "Content-Type: application/json" -d "$3"})" || { echo "[tdoc] no response from $BASE$2" >&2; return 1; }
  http="${resp##*$'\n'}"; body="${resp%$'\n'*}"
  err="$(printf '%s' "$body" | json_get error)"
  if ! printf '%s' "$http" | grep -qE '^2[0-9][0-9]$' || [ -n "$err" ]; then
    if [ -n "$API_SOFT_ERR" ] && [ "$err" = "$API_SOFT_ERR" ]; then return 4; fi
    explain "$body" "$http"; return 1
  fi
  printf '%s' "$body"
}

explain() {
  local err slug; err="$(printf '%s' "$1" | json_get error)"; slug="$(printf '%s' "$1" | json_get slug)"
  case "$err" in
    not_owner) echo "[tdoc] cannot file $slug: only its author (or, in a team, a team admin) can." >&2 ;;
    doc_in_team) echo "[tdoc] $slug is in a team ($(printf '%s' "$1" | json_get team)); pass --team to file it in that team's folders." >&2 ;;
    doc_not_in_team) echo "[tdoc] $slug is not in that team yet: tdoc-move --team <t> --folder <f> $slug" >&2 ;;
    team_not_found) echo "[tdoc] you are not a member of that team." >&2 ;;
    team_required) echo "[tdoc] move-to-team needs --team <name|id>." >&2 ;;
    not_folder_owner) echo "[tdoc] only the folder's maker or a team admin can change or share it." >&2 ;;
    invalid_access_value) echo "[tdoc] --visibility must be unlisted, private or public." >&2 ;;
    too_many_folders) echo "[tdoc] folder limit reached ($(printf '%s' "$1" | json_get limit))." >&2 ;;
    too_deep) echo "[tdoc] folders nest at most $(printf '%s' "$1" | json_get limit) deep." >&2 ;;
    duplicate_name) echo "[tdoc] a folder by that name is already there." >&2 ;;
    folder_not_found) echo "[tdoc] that folder is not in $SPACE (tdoc-folder list${TEAM:+ --team \"$TEAM\"})." >&2 ;;
    *) echo "[tdoc] request failed (HTTP $2): $1" >&2 ;;
  esac
}

# A team id is taken as-is; a name is looked up among your teams.
TEAM_ID=""
if [ -n "$TEAM" ]; then
  if printf '%s' "$TEAM" | grep -qE '^t_[a-f0-9]{16}$'; then
    TEAM_ID="$TEAM"
  else
    TEAM_ID="$(api GET /api/teams | node -e '
      let s = ""; process.stdin.on("data", (d) => s += d).on("end", () => {
        let teams = []; try { teams = JSON.parse(s).teams || []; } catch {}
        const want = process.argv[1].trim().toLowerCase();
        const hit = teams.filter((t) => String(t.id).toLowerCase() === want || String(t.name || "").trim().toLowerCase() === want);
        if (hit.length === 1) { process.stdout.write(String(hit[0].id)); return; }
        process.stderr.write(hit.length
          ? `[tdoc] more than one team is called "${process.argv[1]}"; pass its id (tdoc-move --teams).\n`
          : `[tdoc] you are not in a team called "${process.argv[1]}". Your teams: ${teams.map((t) => t.name).join(", ") || "(none)"}\n`);
        process.exit(1);
      });' "$TEAM")" || exit 1
  fi
fi
TEAM_Q="${TEAM_ID:+?team=$TEAM_ID}"
TEAM_JSON="$( [ -n "$TEAM_ID" ] && json_str "$TEAM_ID" || printf null)"
SPACE="$( [ -n "$TEAM_ID" ] && printf 'team %s' "$TEAM" || printf 'My docs')"
# move-to-team names a My docs folder; --team is where it goes.
if [ "$CMD" = move-to-team ]; then
  [ -n "$TEAM_ID" ] || { echo "[tdoc] move-to-team needs --team <name|id>." >&2; exit 2; }
  TEAM_Q=""; SPACE="My docs"
fi

# Folders made from this machine in the last two minutes, per space. The
# server's folder list is an edge-cached KV read that can lag a create by up
# to a minute, so a second run right after the first would not see the
# folder it made and make another. Remembered ones are merged into the list
# and sent back as hints the server accepts only while they are that fresh.
RECENT_FILE="$HOME/.tdoc/folders-recent.json"
SPACE_KEY="$( [ "$CMD" = move-to-team ] && printf me || printf %s "${TEAM_ID:-me}")"
# recent <op> [json] — get: this space's fresh entries (JSON array);
# add <folder json>: remember one; forget <id>: drop one.
recent() {
  node -e '(() => {
    const fs = require("fs");
    const [file, space, op, arg] = process.argv.slice(1);
    let all = []; try { all = JSON.parse(fs.readFileSync(file, "utf8")); } catch {}
    if (!Array.isArray(all)) all = [];
    const now = Date.now();
    const at = (id) => { const m = /^f_(\d{13})_/.exec(String(id || "")); return m ? Number(m[1]) : 0; };
    all = all.filter((e) => e && e.folder && now - at(e.folder.id) < 110000 && at(e.folder.id) - now < 30000);
    if (op === "get") { process.stdout.write(JSON.stringify(all.filter((e) => e.space === space).map((e) => e.folder))); return; }
    if (op === "add") {
      const f = JSON.parse(arg);
      if (!at(f.id)) return;
      all = all.filter((e) => e.folder.id !== f.id);
      all.push({ space, folder: { id: f.id, name: f.name, parent: f.parent || null } });
    }
    if (op === "forget") all = all.filter((e) => e.folder.id !== arg);
    try { fs.mkdirSync(require("path").dirname(file), { recursive: true }); fs.writeFileSync(file, JSON.stringify(all)); } catch {}
  })()' "$RECENT_FILE" "$SPACE_KEY" "$@" 2>/dev/null || { [ "$1" = get ] && printf '[]'; }
}

# One GET per run: load_folders runs in this shell (not a $(...) subshell),
# so resolve can read the result without asking again. Fresh folders this
# machine made that the (possibly stale) list lacks are merged in.
FOLDERS_JSON=""
load_folders() {
  [ -z "$FOLDERS_JSON" ] || return 0
  FOLDERS_JSON="$(api GET "/api/folders$TEAM_Q")" || return 1
  FOLDERS_JSON="$(printf '%s' "$FOLDERS_JSON" | node -e '
    let s = ""; process.stdin.on("data", (d) => s += d).on("end", () => {
      const b = JSON.parse(s); b.folders = b.folders || [];
      const ids = new Set(b.folders.map((f) => f.id));
      for (const f of JSON.parse(process.argv[1] || "[]")) if (!ids.has(f.id)) b.folders.push(f);
      process.stdout.write(JSON.stringify(b));
    });' "$(recent get)")"
}

# folder_def <id> — {id,name,parent} of a listed folder, for the server to
# put back if its read is stale; null when unknown.
folder_def() {
  printf '%s' "$FOLDERS_JSON" | node -e '
    let s = ""; process.stdin.on("data", (d) => s += d).on("end", () => {
      let f = null; try { f = (JSON.parse(s).folders || []).find((x) => x.id === process.argv[1]); } catch {}
      process.stdout.write(f ? JSON.stringify({ id: f.id, name: f.name, parent: f.parent || null }) : "null");
    });' "$1"
}

# resolve <folder> — prints the folder id; exit 3 when there is no such folder.
resolve() {
  printf '%s' "$FOLDERS_JSON" | node -e '
    let s = ""; process.stdin.on("data", (d) => s += d).on("end", () => {
      const folders = (JSON.parse(s).folders || []);
      const byId = new Map(folders.map((f) => [f.id, f]));
      const path = (f) => { const out = []; for (let c = f, i = 0; c && i < 8; c = byId.get(c.parent), i++) out.unshift(c.name); return out.join("/"); };
      const want = process.argv[1].trim();
      const low = want.toLowerCase();
      let hit = folders.filter((f) => f.id === want);
      if (!hit.length) hit = folders.filter((f) => path(f).toLowerCase() === low.replace(/^\/+|\/+$/g, ""));
      if (!hit.length) hit = folders.filter((f) => f.name.toLowerCase() === low);
      if (hit.length === 1) { process.stdout.write(hit[0].id); return; }
      if (hit.length > 1) {
        process.stderr.write(`[tdoc] more than one folder is called "${want}": ${hit.map((f) => `${path(f)} (${f.id})`).join(", ")}. Pass a path or id.\n`);
        process.exit(1);
      }
      process.exit(3);
    });' "$1"
}

require_folder() {
  local id rc=0
  id="$(resolve "$1")" || rc=$?
  if [ "$rc" = 3 ]; then echo "[tdoc] no folder \"$1\" in $SPACE (tdoc-folder list${TEAM:+ --team \"$TEAM\"})." >&2; return 1; fi
  [ "$rc" = 0 ] || return 1
  printf '%s' "$id"
}

# create_folder <name> — idempotent; prints the folder's {id,name,parent}
# JSON, which the caller hands straight to the move (never re-listed: the
# list may not show it yet).
create_folder() {
  local parent_id="" resp def
  if [ -n "$PARENT" ]; then parent_id="$(require_folder "$PARENT")" || return 1; fi
  resp="$(api POST /api/folders "{\"name\":$(json_str "$1"),\"parent\":$( [ -n "$parent_id" ] && json_str "$parent_id" || printf null),\"team\":$TEAM_JSON,\"existing_ok\":true,\"known\":$(recent get)}")" || return 1
  def="$(printf '%s' "$resp" | node -e '
    let s = ""; process.stdin.on("data", (d) => s += d).on("end", () => {
      const f = JSON.parse(s).folder || {};
      process.stdout.write(JSON.stringify({ id: f.id, name: f.name, parent: f.parent || null }));
    });')"
  if [ "$(printf '%s' "$resp" | json_get existed)" = "true" ]; then
    echo "[tdoc] folder \"$1\" already in $SPACE ($(printf '%s' "$resp" | json_get folder.id))" >&2
  else
    echo "[tdoc] created folder \"$1\" in $SPACE ($(printf '%s' "$resp" | json_get folder.id))" >&2
  fi
  recent add "$def"
  printf '%s' "$def"
}

slugs_json() { printf '%s\n' "$@" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>process.stdout.write(JSON.stringify(s.split("\n").filter(Boolean))))'; }

case "$CMD" in
  list|ls|add|rename|delete|rm|share|unshare|move-to-team) load_folders || exit 1 ;;
  *) if [ -n "$PARENT" ]; then load_folders || exit 1; fi ;;
esac

case "$CMD" in
  list|ls)
    if [ "$AS_JSON" = 1 ]; then printf '%s\n' "$FOLDERS_JSON"; exit 0; fi
    printf '%s' "$FOLDERS_JSON" | node -e '
      let s = ""; process.stdin.on("data", (d) => s += d).on("end", () => {
        const b = JSON.parse(s); const folders = b.folders || [];
        const byId = new Map(folders.map((f) => [f.id, f]));
        const path = (f) => { const out = []; for (let c = f, i = 0; c && i < 8; c = byId.get(c.parent), i++) out.unshift(c.name); return out.join("/"); };
        const counts = {};
        for (const fid of Object.values(b.docs || {})) counts[fid] = (counts[fid] || 0) + 1;
        if (!folders.length) { process.stderr.write("[tdoc] no folders yet\n"); return; }
        for (const f of folders.map((f) => [path(f), f]).sort((a, b) => a[0].localeCompare(b[0]))) {
          const docs = b.docs ? `\t${counts[f[1].id] || 0} docs` : "";
          console.log(`${f[1].id}\t${f[0]}${docs}`);
        }
      });'
    ;;
  create|mkdir)
    [ "${#ARGS[@]}" -eq 1 ] || usage
    create_folder "${ARGS[0]}" >/dev/null || exit 1
    ;;
  add|remove)
    [ "${#ARGS[@]}" -ge 1 ] || usage
    if [ "$CMD" = add ]; then
      [ -n "$FOLDER" ] || { echo "[tdoc] add needs --folder <folder>" >&2; exit 2; }
      rc=0; FID="$(resolve "$FOLDER")" || rc=$?
      if [ "$rc" = 3 ] && [ "$CREATE" = 1 ]; then
        DEF="$(create_folder "$FOLDER")" || exit 1
        FID="$(printf '%s' "$DEF" | json_get id)"
      elif [ "$rc" = 3 ]; then
        echo "[tdoc] no folder \"$FOLDER\" in $SPACE; pass --create to make it." >&2; exit 1
      elif [ "$rc" != 0 ]; then exit 1
      else DEF="$(folder_def "$FID")"; fi
      DEST="$(json_str "$FID"),\"folder_def\":$DEF"
    else
      DEST=null
    fi
    MOVE_BODY="{\"slugs\":$(slugs_json "${ARGS[@]}"),\"folder\":$DEST,\"team\":$TEAM_JSON}"
    # A folder made a moment ago can still read as missing at another edge;
    # one short retry covers that before giving up.
    rc=0; resp="$(API_SOFT_ERR=folder_not_found api POST /api/folders/move "$MOVE_BODY")" || rc=$?
    if [ "$rc" = 4 ]; then
      sleep "${TDOC_FOLDER_RETRY_DELAY:-3}"
      resp="$(api POST /api/folders/move "$MOVE_BODY")" || exit 1
    elif [ "$rc" != 0 ]; then exit 1; fi
    if [ "$CMD" = add ]; then echo "[tdoc] in $SPACE / $FOLDER: ${ARGS[*]}"; else echo "[tdoc] top level of $SPACE: ${ARGS[*]}"; fi
    ;;
  rename)
    [ "${#ARGS[@]}" -eq 2 ] || usage
    FID="$(require_folder "${ARGS[0]}")" || exit 1
    api PATCH /api/folders "{\"id\":$(json_str "$FID"),\"name\":$(json_str "${ARGS[1]}"),\"team\":$TEAM_JSON}" >/dev/null || exit 1
    echo "[tdoc] renamed ${ARGS[0]} → ${ARGS[1]}"
    ;;
  delete|rm)
    [ "${#ARGS[@]}" -eq 1 ] || usage
    FID="$(require_folder "${ARGS[0]}")" || exit 1
    # The folder goes to Trash with its docs a batch per request; keep asking
    # until nothing remains, then print what the server says happened.
    AFTER=""
    while :; do
      RESP="$(api DELETE "/api/folders?batch=1&id=$FID${TEAM_ID:+&team=$TEAM_ID}${AFTER:+&after=$AFTER}")" || exit 1
      [ "$(printf '%s' "$RESP" | json_get remaining)" = "true" ] || break
      AFTER="$(printf '%s' "$RESP" | json_get after)"
      printf '%s\n' "[tdoc] $(printf '%s' "$RESP" | json_get message)" >&2
    done
    recent forget "$FID"
    echo "[tdoc] $(printf '%s' "$RESP" | json_get message)"
    ;;
  share)
    [ "${#ARGS[@]}" -eq 1 ] || usage
    case "$VISIBILITY" in ""|unlisted|private|public) ;; *) echo "[tdoc] --visibility must be unlisted, private or public." >&2; exit 2 ;; esac
    FID="$(require_folder "${ARGS[0]}")" || exit 1
    if [ -z "$VISIBILITY" ]; then
      # Sharing again only prints the link: a shared folder keeps its setting.
      VISIBILITY="$(printf '%s' "$FOLDERS_JSON" | node -e '
        let s = ""; process.stdin.on("data", (d) => s += d).on("end", () => {
          const f = (JSON.parse(s).folders || []).find((x) => x.id === process.argv[1]) || {};
          process.stdout.write(f.share_id && f.visibility ? f.visibility : "unlisted");
        });' "$FID")"
    fi
    resp="$(api PATCH /api/folders "{\"id\":$(json_str "$FID"),\"visibility\":$(json_str "$VISIBILITY"),\"team\":$TEAM_JSON}")" || exit 1
    SID="$(printf '%s' "$resp" | json_get folder.share_id)"
    [ -n "$SID" ] || { echo "[tdoc] the server returned no link: $resp" >&2; exit 1; }
    case "$VISIBILITY" in
      private) echo "[tdoc] shared ${ARGS[0]} ($VISIBILITY: ${TEAM_ID:+team members and }invitees only; docs keep their own access)" >&2 ;;
      *) echo "[tdoc] shared ${ARGS[0]} ($VISIBILITY: anyone with the link; docs keep their own access)" >&2 ;;
    esac
    printf '%s/f/%s\n' "$BASE" "$SID"
    ;;
  unshare)
    [ "${#ARGS[@]}" -eq 1 ] || usage
    FID="$(require_folder "${ARGS[0]}")" || exit 1
    api PATCH /api/folders "{\"id\":$(json_str "$FID"),\"share\":false,\"team\":$TEAM_JSON}" >/dev/null || exit 1
    echo "[tdoc] stopped sharing ${ARGS[0]}; its link no longer opens."
    ;;
  move-to-team)
    [ "${#ARGS[@]}" -eq 1 ] || usage
    FID="$(require_folder "${ARGS[0]}")" || exit 1
    # One call moves a bounded batch and says how many are left; loop until
    # none are, handing back the team folders made (`known`) and the docs
    # already moved (`done`) so a stale read on the next call loses neither.
    STATE='{"known":[],"done":[],"moved":0,"skipped":[],"remaining":-1}'
    while :; do
      BODY="$(printf '%s' "$STATE" | node -e '
        let s = ""; process.stdin.on("data", (d) => s += d).on("end", () => {
          const st = JSON.parse(s);
          process.stdout.write(JSON.stringify({ folder: process.argv[1], team: process.argv[2], known: st.known, done: st.done }));
        });' "$FID" "$TEAM_ID")"
      resp="$(api POST /api/folders/move-to-team "$BODY")" || exit 1
      STATE="$(node -e '
        const st = JSON.parse(process.argv[1]); const r = JSON.parse(process.argv[2]);
        const results = r.results || [];
        const progress = results.filter((x) => !(x.status === "skipped" && x.reason === "not_owner")).length;
        st.stuck = r.remaining > 0 && !progress;
        st.known = r.folders || st.known;
        st.done = [...new Set([...st.done, ...results.filter((x) => !(x.status === "skipped" && x.reason === "not_owner")).map((x) => x.slug)])];
        st.moved += r.moved || 0;
        for (const x of results) if (x.status === "skipped" && !st.skipped.some((y) => y.slug === x.slug)) st.skipped.push({ slug: x.slug, reason: x.reason });
        st.remaining = r.remaining || 0;
        st.folder = r.folder; st.team = r.team; st.kept = r.kept_folders || 0;
        if (r.remaining) process.stderr.write(`[tdoc] moved ${st.moved} so far, ${r.remaining} to go…\n`);
        process.stdout.write(JSON.stringify(st));' "$STATE" "$resp")" || exit 1
      [ "$(printf '%s' "$STATE" | json_get remaining)" = 0 ] && break
      if [ "$(printf '%s' "$STATE" | json_get stuck)" = true ]; then
        echo "[tdoc] stopped: the docs left in ${ARGS[0]} are not yours to move." >&2; break
      fi
    done
    printf '%s' "$STATE" | node -e '
      let s = ""; process.stdin.on("data", (d) => s += d).on("end", () => {
        const st = JSON.parse(s); const [name, base] = process.argv.slice(1);
        const why = { not_owner: "not yours", in_other_team: "already in another team", not_found: "no longer exists" };
        process.stderr.write(`[tdoc] moved ${st.moved} doc${st.moved === 1 ? "" : "s"} from My docs / ${name} into team ${st.team.name} / ${name}\n`);
        for (const x of st.skipped) process.stderr.write(`[tdoc]   skipped ${x.slug}: ${why[x.reason] || x.reason}\n`);
        if (st.kept) process.stderr.write(`[tdoc] ${st.kept} My docs folder${st.kept === 1 ? "" : "s"} kept for the docs that stayed.\n`);
        process.stdout.write(`${base}/me?team=${encodeURIComponent(st.team.id)}&folder=${encodeURIComponent(st.folder)}\n`);
      });' "${ARGS[0]}" "$BASE"
    ;;
esac

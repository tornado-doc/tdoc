#!/usr/bin/env bash
# tdoc-propose — suggest edits to a doc instead of publishing (Ask/Edit v2).
# The edits show in the doc as suggestions the person accepts or rejects;
# nothing is published. The CLI counterpart of the propose_edits MCP tool,
# a thin wrapper over POST /api/docs/<slug>/suggestions.
#
# Usage:
#   tdoc-propose --slug <slug> --edits edits.json [--comment <id>]... [--summary "..."]
#     edits.json: [{"find":"exact visible text","replace":"new text","comment_id":"c_..."}]
#     Each find must match exactly once in the latest version's visible text,
#     inside one paragraph (no markup).
#
# Uses the sign-in in ~/.tdoc/published.json, like tdoc-agent-reply.

set -euo pipefail
TDOC_BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$TDOC_BIN_DIR/lib/json.sh"

SLUG=""; EDITS=""; SUMMARY=""; COMMENTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --slug) SLUG="${2:-}"; shift 2 ;;
    --edits) EDITS="${2:-}"; shift 2 ;;
    --comment|--comment-id) COMMENTS+=("${2:-}"); shift 2 ;;
    --summary) SUMMARY="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
if [ -z "$SLUG" ] || [ -z "$EDITS" ] || [ ! -f "$EDITS" ]; then
  echo "usage: tdoc-propose --slug <slug> --edits edits.json [--comment <id>] [--summary \"...\"]" >&2
  exit 1
fi
if ! printf '%s' "$SLUG" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$'; then echo "[tdoc] invalid slug '$SLUG'" >&2; exit 1; fi
# Under the local agent daemon, only the doc it is running.
if [ -n "${TDOC_DAEMON_SLUG:-}" ] && [ "$SLUG" != "$TDOC_DAEMON_SLUG" ]; then
  echo "[tdoc] the daemon may only suggest on \"$TDOC_DAEMON_SLUG\"." >&2; exit 2
fi
if [ -n "${TDOC_DAEMON_ASK:-}" ]; then echo "[tdoc] a question run cannot suggest edits." >&2; exit 2; fi

LOGIN="$(bash "$TDOC_BIN_DIR/tdoc-agent-reply" --print-identity | json_get login)"
NAME="$(bash "$TDOC_BIN_DIR/tdoc-agent-reply" --print-identity | json_get name)"
PAYLOAD="$(node -e '
  const fs = require("fs");
  const [file, summary, login, name, ...comments] = process.argv.slice(1);
  let edits;
  try { edits = JSON.parse(fs.readFileSync(file, "utf8")); } catch (e) { console.error("[tdoc] " + file + " is not JSON: " + e.message); process.exit(1); }
  if (!Array.isArray(edits)) edits = edits && Array.isArray(edits.edits) ? edits.edits : [];
  const o = { edits, agent_login: login, agent_name: name };
  if (summary) o.summary = summary;
  if (comments.length) o.comment_ids = comments;
  process.stdout.write(JSON.stringify(o));
' "$EDITS" "$SUMMARY" "$LOGIN" "$NAME" ${COMMENTS[@]+"${COMMENTS[@]}"})"

HDR=()
if [ -n "${TDOC_AGENT:-}" ] && printf '%s' "$TDOC_AGENT" | grep -Eq '^[a-z]{1,20}/[A-Za-z0-9_-]{1,80}/[A-Za-z0-9_-]{1,80}$'; then
  HDR+=(-H "X-Tdoc-Agent: ${TDOC_AGENT}")
fi

CONFIG_FILE="$HOME/.tdoc/published.json"
[ -f "$CONFIG_FILE" ] || { echo "[tdoc] not signed in: run tdoc-publish --signin-only" >&2; exit 1; }
TOKEN="$(json_file_get "$CONFIG_FILE" upload_token)"
BASE="$(json_file_get "$CONFIG_FILE" base)"
[ -n "$TOKEN" ] && [ -n "$BASE" ] || { echo "[tdoc] $CONFIG_FILE has no base/upload_token: sign in with tdoc-publish --signin-only" >&2; exit 1; }

resp="$(curl -sS --max-time 30 -w $'\n%{http_code}' -X POST "${BASE}/api/docs/${SLUG}/suggestions" \
  -H "Authorization: Bearer $TOKEN" ${HDR[@]+"${HDR[@]}"} -H "Content-Type: application/json" -d "$PAYLOAD")" || {
  echo "[tdoc] edits NOT suggested: network error" >&2; exit 1; }
http="${resp##*$'\n'}"; body="${resp%$'\n'*}"
printf '%s\n' "$body"
if ! printf '%s' "$http" | grep -qE '^2[0-9][0-9]$'; then
  echo "[tdoc] edits NOT suggested ($(printf '%s' "$body" | json_get error 2>/dev/null)): $(printf '%s' "$body" | json_get message 2>/dev/null)" >&2
  exit 1
fi
echo "[tdoc] suggested; nothing was published. The person accepts or rejects them in the doc." >&2

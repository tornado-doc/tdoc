#!/usr/bin/env bash
# tdoc-agent-reply — post an agent reply and stamp the host runtime logo.
#
# Detects Claude Code / Codex / Grok / Cursor / Gemini from the environment
# so agents do not have to remember --login. Explicit --login wins.
#
# Usage:
#   tdoc-agent-reply --slug <slug> --parent <id> --text "..." \
#     [--status applied|partial|question] [--applied-in N] \
#     [--login grok] [--name Grok] [--avatar-url https://...]
#   tdoc-agent-reply --print-identity   # login/name JSON, no network
#
# Posts to the published worker when ~/.tdoc/published.json exists,
# otherwise to http://localhost:${TDOC_PORT:-7878}.

set -euo pipefail

SLUG=""
PARENT=""
TEXT=""
STATUS=""
APPLIED_IN=""
LOGIN=""
NAME=""
AVATAR=""
PRINT_IDENTITY=0

while [ $# -gt 0 ]; do
  case "$1" in
    --slug) SLUG="${2:-}"; shift 2 ;;
    --parent|--parent-id) PARENT="${2:-}"; shift 2 ;;
    --text) TEXT="${2:-}"; shift 2 ;;
    --status) STATUS="${2:-}"; shift 2 ;;
    --applied-in) APPLIED_IN="${2:-}"; shift 2 ;;
    --login) LOGIN="${2:-}"; shift 2 ;;
    --name) NAME="${2:-}"; shift 2 ;;
    --avatar-url) AVATAR="${2:-}"; shift 2 ;;
    --print-identity) PRINT_IDENTITY=1; shift ;;
    -h|--help)
      sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

detect_login() {
  if [ -n "${GROK_AGENT:-}${GROK_SESSION_ID:-}${GROK_BUILD:-}${XAI_AGENT:-}" ]; then echo grok; return; fi
  if [ -n "${CLAUDE_CODE:-}${CLAUDE_SESSION_ID:-}${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}${CLAUDE_CODE_SSE_PORT:-}" ]; then echo claude; return; fi
  if [ -n "${CODEX_SESSION_ID:-}${CODEX_CLI:-}${OPENAI_CODEX:-}${CODEX_HOME:-}" ]; then echo codex; return; fi
  if [ -n "${CURSOR_TRACE_ID:-}${CURSOR_AGENT:-}${COMPOSER_SESSION:-}" ]; then echo cursor; return; fi
  if [ -n "${GEMINI_CLI:-}${GEMINI_SESSION_ID:-}" ]; then echo gemini; return; fi
  echo ""
}

if [ -z "$LOGIN" ] || [ "$LOGIN" = "tdoc-agent" ] || [ "$LOGIN" = "agent" ]; then
  LOGIN="$(detect_login)"
fi
[ -z "$LOGIN" ] && LOGIN="tdoc-agent"
if [ -z "$NAME" ]; then
  case "$LOGIN" in
    grok) NAME="Grok" ;;
    claude) NAME="Claude" ;;
    codex) NAME="Codex" ;;
    cursor) NAME="Cursor" ;;
    gemini) NAME="Gemini" ;;
    *) NAME="$LOGIN" ;;
  esac
fi

if [ "$PRINT_IDENTITY" = 1 ]; then
  printf '{"login":"%s","name":"%s"}\n' "$LOGIN" "$NAME"
  exit 0
fi

if [ -z "$SLUG" ] || [ -z "$PARENT" ] || [ -z "$TEXT" ]; then
  echo "usage: tdoc-agent-reply --slug <slug> --parent <id> --text \"...\"" >&2
  exit 1
fi
if ! printf '%s' "$SLUG" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$'; then
  echo "[tdoc] invalid slug '$SLUG'" >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then echo "needs jq" >&2; exit 1; fi

PAYLOAD="$(jq -n \
  --arg slug "$SLUG" \
  --arg parent "$PARENT" \
  --arg text "$TEXT" \
  --arg status "$STATUS" \
  --arg applied "$APPLIED_IN" \
  --arg login "$LOGIN" \
  --arg name "$NAME" \
  --arg avatar "$AVATAR" \
  '{
    slug: $slug,
    parent_id: $parent,
    text: $text,
    agent_login: $login,
    agent_name: $name
  }
  + (if $status != "" then {status: $status} else {} end)
  + (if $applied != "" then {applied_in: ($applied|tonumber)} else {} end)
  + (if $avatar != "" then {agent_avatar_url: $avatar} else {} end)
')"

CONFIG_FILE="$HOME/.tdoc/published.json"
if [ -f "$CONFIG_FILE" ]; then
  PLATFORM="$(jq -r '.platform // "cloudflare"' "$CONFIG_FILE")"
  TOKEN="$(jq -r '.upload_token // empty' "$CONFIG_FILE")"
  if [ "$PLATFORM" = "vercel" ]; then
    HOST="$(jq -r '.public_host // empty' "$CONFIG_FILE")"
    BASE="$(jq -r '.base // empty' "$CONFIG_FILE")"
    if [ -n "$HOST" ] && [ "$HOST" != "null" ]; then
      BASE="https://${HOST}"
    fi
  else
    SUBDOMAIN="$(jq -r .subdomain "$CONFIG_FILE")"
    WORKER="$(jq -r .worker "$CONFIG_FILE")"
    BASE="https://${WORKER}.${SUBDOMAIN}.workers.dev"
  fi
  if [ -n "$TOKEN" ] && [ -n "$BASE" ] && [ "$BASE" != "https://." ]; then
    curl -sS --max-time 20 -X POST "${BASE}/api/agent/reply" \
      -H "Authorization: Bearer $TOKEN" \
      -H "Content-Type: application/json" \
      -d "$PAYLOAD"
    echo
    exit 0
  fi
fi

TDOC_PORT="${TDOC_PORT:-7878}"
curl -sS --max-time 20 -X POST "http://localhost:${TDOC_PORT}/api/agent/reply" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD"
echo

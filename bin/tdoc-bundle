#!/usr/bin/env node
// tdoc-bundle — inline the chrome/shell modules + provenance into _worker.bundled.js
//
// Used by tdoc-publish (BYOK) and by the tdoc.dev CD workflow. Same transform
// either way; GENERATED_BY distinguishes who produced the bundle.
//
// Env:
//   SKILL_DIR           repo/skill root (default: parent of this file)
//   OUT_DIR             directory to write the bundle (default: $SKILL_DIR/worker)
//   TDOC_GENERATED_BY   provenance label (default: tdoc-bundle)
//   TDOC_SOURCE_SHA     optional override for source_sha (CI passes github.sha)
//   TDOC_PREVIEW=1      un-export CommentsStore so Cloudflare will mint preview URLs

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');
const cp = require('child_process');

const skill = process.env.SKILL_DIR || path.join(__dirname, '..');
const outDir = process.env.OUT_DIR || path.join(skill, 'worker');
const generatedBy = process.env.TDOC_GENERATED_BY || 'tdoc-bundle';

const worker = fs.readFileSync(path.join(skill, 'worker/worker.js'), 'utf8');
// The shell builder runs server-side in the worker; the framework-free probe is
// injected into isolated author frames.
const shellMod = fs.readFileSync(path.join(skill, 'server/shell.js'), 'utf8');
const frameProbe = require(path.join(skill, 'server/frame-probe-source.js'))();
const readerCss = fs.readFileSync(path.join(skill, 'server/reader.css'), 'utf8');
const runtimeManifest = JSON.parse(fs.readFileSync(path.join(skill, 'server/runtime/manifest.json'), 'utf8'));
const runtimeEntry = Object.values(runtimeManifest).find((item) => item && item.isEntry);
if (!runtimeEntry || !runtimeEntry.file || !Array.isArray(runtimeEntry.css) || !runtimeEntry.css[0]) {
  console.error('bundle: shell runtime manifest has no JS/CSS entry; run npm run build:shell');
  process.exit(1);
}
const runtimeJsPath = '/' + runtimeEntry.file;
const runtimeCssPath = '/' + runtimeEntry.css[0];
const runtimeJs = fs.readFileSync(path.join(skill, 'server/runtime', runtimeEntry.file), 'utf8');
const runtimeCss = fs.readFileSync(path.join(skill, 'server/runtime', runtimeEntry.css[0]), 'utf8');
const sha = (s) => crypto.createHash('sha256').update(s).digest('hex');
const git = (...args) => {
  try {
    return cp.execFileSync('git', ['-C', skill, ...args], {
      encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
  } catch {
    return '';
  }
};

const sourceSha = (process.env.TDOC_SOURCE_SHA || git('rev-parse', '--short=12', 'HEAD') || '').slice(0, 12) || null;
const sourceDirty = !!git('status', '--porcelain', '--untracked-files=no');
// bundleSha covers every source the bundle inlines, including the Vite assets.
const bundleSha = sha([worker, shellMod, frameProbe, readerCss, runtimeJs, runtimeCss].join('\0'));
const build = {
  source_sha: sourceSha,
  source_dirty: sourceDirty,
  worker_sha: sha(worker).slice(0, 12),
  bundle_sha: bundleSha.slice(0, 12),
  built_at: new Date().toISOString(),
  generated_by: generatedBy,
};

let replaced = worker;
// The shell builder is inlined as code. Each replace is checked so a renamed
// placeholder fails the build instead of silently disabling the architecture.
function mustReplace(hay, needle, sub, label) {
  // Runtime bundles may contain replacement tokens such as $&, $`, and $'.
  // A callback keeps those bytes literal instead of letting String.replace
  // expand them against the Worker placeholder.
  const out = hay.replace(needle, () => sub);
  if (out === hay) { console.error('bundle: failed to find ' + label + ' placeholder'); process.exit(1); }
  return out;
}
replaced = mustReplace(replaced, '/* __TDOC_SHELL_MODULE__ */', shellMod, 'SHELL_MODULE');
replaced = mustReplace(replaced, /const PROBE_JS = `__TDOC_PROBE_JS__`;/, 'const PROBE_JS = ' + JSON.stringify(frameProbe) + ';', 'PROBE_JS');
replaced = mustReplace(replaced, /const READER_CSS = `__TDOC_READER_CSS__`;/, 'const READER_CSS = ' + JSON.stringify(readerCss) + ';', 'READER_CSS');
replaced = mustReplace(replaced, /const SHELL_RUNTIME_JS_PATH = "__TDOC_SHELL_RUNTIME_JS_PATH__";/, 'const SHELL_RUNTIME_JS_PATH = ' + JSON.stringify(runtimeJsPath) + ';', 'SHELL_RUNTIME_JS_PATH');
replaced = mustReplace(replaced, /const SHELL_RUNTIME_JS = `__TDOC_SHELL_RUNTIME_JS__`;/, 'const SHELL_RUNTIME_JS = ' + JSON.stringify(runtimeJs) + ';', 'SHELL_RUNTIME_JS');
replaced = mustReplace(replaced, /const SHELL_RUNTIME_CSS_PATH = "__TDOC_SHELL_RUNTIME_CSS_PATH__";/, 'const SHELL_RUNTIME_CSS_PATH = ' + JSON.stringify(runtimeCssPath) + ';', 'SHELL_RUNTIME_CSS_PATH');
replaced = mustReplace(replaced, /const SHELL_RUNTIME_CSS = `__TDOC_SHELL_RUNTIME_CSS__`;/, 'const SHELL_RUNTIME_CSS = ' + JSON.stringify(runtimeCss) + ';', 'SHELL_RUNTIME_CSS');

let withBuild = replaced.replace(
  /const TDOC_BUILD_INFO = "__TDOC_BUILD_INFO__";/,
  'const TDOC_BUILD_INFO = ' + JSON.stringify(build) + ';'
);
if (withBuild === replaced) {
  console.error('bundle: failed to find TDOC_BUILD_INFO placeholder');
  process.exit(1);
}

// Preview Worker must not *implement* a Durable Object. Cloudflare skips
// preview URLs for scripts that export a DO class, even with no binding.
if (process.env.TDOC_PREVIEW === '1') {
  const stripped = withBuild.replace('export class CommentsStore {', 'class CommentsStore {');
  if (stripped === withBuild) {
    console.error('bundle: preview strip failed — export class CommentsStore not found');
    process.exit(1);
  }
  withBuild = stripped;
}

fs.mkdirSync(outDir, { recursive: true });
fs.writeFileSync(path.join(outDir, '_worker.bundled.js'), withBuild);
fs.writeFileSync(path.join(outDir, '_worker.bundled.sha256'), bundleSha + '\n');
console.log('bundled: ' + path.join(outDir, '_worker.bundled.js'));

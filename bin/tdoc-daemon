#!/usr/bin/env bash
# tdoc-daemon — run handoffs addressed to this computer's CLI agents.
#
# Polls tdoc for comments handed to "claude on <this computer>" / "codex on
# <this computer>", runs that CLI non-interactively on them, and marks them
# resolved. The logic lives in lib/daemon.js; this wrapper exists so the
# command is invoked the same way as every other tdoc CLI (`bash
# "$SKILL_DIR/bin/tdoc-daemon" …`, which also works on noexec skill mounts).
#
# Usage:
#   tdoc-daemon start [--cli claude,codex] [--interval 60] [--workdir DIR]
#   tdoc-daemon once                  # one poll, for cron or launchd
#   tdoc-daemon status
#   tdoc-daemon install               # macOS: run it at login (LaunchAgent), then status
#   tdoc-daemon uninstall             # stop it and remove the LaunchAgent
#   tdoc-daemon state                 # local state as JSON (for tdoc-doctor)
#   tdoc-daemon install-launchd       # prints a LaunchAgent plist; does not load it
#   tdoc-daemon connect-team CODE     # make this machine a team's agent (team settings -> Agents)
set -euo pipefail
TDOC_BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
export TDOC_SKILL_DIR="${TDOC_SKILL_DIR:-$(cd "$TDOC_BIN_DIR/.." && pwd)}"
exec node "$TDOC_BIN_DIR/lib/daemon.js" "$@"

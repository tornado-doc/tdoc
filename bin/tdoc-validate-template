#!/usr/bin/env python3
"""Validate tdoc host HTML before it can create a broken document.

The host CSP deliberately blocks author JavaScript. Computation belongs in a
sandboxed widget island, never in index.html. The validator also protects the
reader layout while allowing the selected house style under `.wrap`.
"""

from __future__ import annotations

import argparse
import re
import sys
from html import unescape
from html.parser import HTMLParser
from pathlib import Path


VOID_TAGS = {
    "area", "base", "br", "col", "embed", "hr", "img", "input", "link",
    "meta", "param", "source", "track", "wbr",
}
PROSE_TAGS = {
    "h1", "h2", "h3", "h4", "h5", "h6", "p", "ul", "ol", "li", "a",
    "blockquote", "pre", "code", "table", "thead", "tbody", "tfoot", "tr",
    "th", "td", "dl", "dt", "dd",
}
GLOBAL_SELECTOR_TAGS = PROSE_TAGS | {
    "button", "input", "label", "img", "svg", "canvas", "video", "iframe",
    "main", "article", "footer",
}
ROOT_CLASSES = {"wrap", "content", "container"}
HOUSE_STYLES = {"default", "technical", "editorial", "paper"}
HOUSE_BACKGROUNDS = {
    "default": {"#fff", "#ffffff", "white", "rgb(255,255,255)"},
    "technical": {"#fff", "#ffffff", "white", "rgb(255,255,255)"},
    "editorial": {"#f7f6f5"},
    "paper": {"#faf9f5"},
}
ROOT_LAYOUT_PROPERTIES = {
    "width", "min-width", "max-width", "margin", "margin-left", "margin-right",
    "padding", "padding-left", "padding-right", "position", "left", "right",
    "inset", "transform",
}


class ContractParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.in_body = False
        self.body_depth = 0
        self.in_style = False
        self.in_reader_style = False
        self.style_chunks: list[str] = []
        self.styles: list[str] = []
        self.has_viewport = False
        self.primary_roots = 0
        self.stray_body_children: list[str] = []
        self.has_footer = False
        self.inline_prose_styles: list[str] = []
        self.author_scripts = 0
        self.event_handlers: list[str] = []
        self.javascript_urls: list[str] = []
        self.host_canvas = 0

    def handle_starttag(self, tag: str, attrs_list: list[tuple[str, str | None]]) -> None:
        tag = tag.lower()
        attrs = {key.lower(): (value or "") for key, value in attrs_list}

        if tag == "meta" and attrs.get("name", "").lower() == "viewport":
            self.has_viewport = True
        if tag == "style":
            self.in_style = True
            # <style id="tdoc-reader"> is the reader template ITSELF, baked in
            # by tdoc-new so docs are self-contained under the shell. It is
            # tdoc's CSS, not author CSS — exempt it from author-style checks.
            self.in_reader_style = attrs.get("id", "") == "tdoc-reader"
            self.style_chunks = []
        if tag == "footer":
            self.has_footer = True
        if tag == "script":
            self.author_scripts += 1
        if tag == "canvas":
            self.host_canvas += 1
        if tag in PROSE_TAGS and "style" in attrs:
            self.inline_prose_styles.append(tag)
        for name, value in attrs.items():
            if name.startswith("on"):
                self.event_handlers.append(f"{tag}[{name}]")
            if name in {"href", "src", "action", "formaction"} and value.lstrip().lower().startswith("javascript:"):
                self.javascript_urls.append(f"{tag}[{name}]")

        if tag == "body":
            self.in_body = True
            self.body_depth = 0
            return

        if self.in_body:
            if self.body_depth == 0:
                classes = set(attrs.get("class", "").split())
                if tag in {"main", "article"} or classes.intersection(ROOT_CLASSES):
                    self.primary_roots += 1
                elif tag not in {"script", "style", "template", "noscript"}:
                    # A sibling of the content root. Almost always the tail of a
                    # document whose root was closed early by one stray </div>:
                    # everything after it lands here and loses the reading column.
                    self.stray_body_children.append(tag)
            if tag not in VOID_TAGS:
                self.body_depth += 1

    def handle_endtag(self, tag: str) -> None:
        tag = tag.lower()
        if tag == "style" and self.in_style:
            if not self.in_reader_style:
                self.styles.append("".join(self.style_chunks))
            self.style_chunks = []
            self.in_style = False
            self.in_reader_style = False
        if tag == "body":
            self.in_body = False
            self.body_depth = 0
        elif self.in_body and tag not in VOID_TAGS:
            self.body_depth = max(0, self.body_depth - 1)

    def handle_data(self, data: str) -> None:
        if self.in_style:
            self.style_chunks.append(data)


def split_declarations(body: str) -> list[tuple[str, str]]:
    declarations: list[tuple[str, str]] = []
    for part in body.split(";"):
        if not part.strip():
            continue
        if ":" not in part:
            declarations.append((part.strip().lower(), ""))
            continue
        prop, value = part.split(":", 1)
        declarations.append((prop.strip().lower(), value.strip().lower()))
    return declarations


def selector_is_global(selector: str) -> bool:
    selector = re.sub(r"\s+", " ", selector.strip().lower())
    if selector in {"*", ":root"}:
        return True
    if re.match(r"^(?:html|body)(?:$|[\s:>+~.#\[])", selector):
        return True
    tag_pattern = "|".join(sorted(GLOBAL_SELECTOR_TAGS, key=len, reverse=True))
    return re.match(rf"^(?:{tag_pattern})(?:$|[\s:>+~.#\[])", selector) is not None


def compact_css_value(value: str) -> str:
    return re.sub(r"\s+", "", value.strip().lower())


STYLE_ACCENTS = {
    "default": ("#f7d7d1", "#e0a99e", "#b3503c", "#dde7f9", "#a9c0ee", "#26407a"),
}


def _css_rules(blocks):
    """[css text] -> {selector: {prop: value}}, comments stripped."""
    out = {}
    for css in blocks:
        css = re.sub(r"/\*.*?\*/", "", css, flags=re.S)
        for m in re.finditer(r"([^{}]+)\{([^}]*)\}", css):
            sel = " ".join(m.group(1).split())
            if not sel:
                continue
            props = out.setdefault(sel, {})
            for decl in m.group(2).split(";"):
                if ":" in decl:
                    k, v = decl.split(":", 1)
                    props[k.strip()] = " ".join(v.split())
    return out


def _norm(v):
    return (v or "").replace(" ", "").replace('"', "'").lower()


def check_style_contract(styles, style):
    """Every declaration the style file makes must survive into the document."""
    md = Path(__file__).resolve().parent.parent / "authoring" / "style" / (style + ".md")
    if not md.exists():
        return []
    declared = _css_rules(re.findall(r"```css\n(.*?)```", md.read_text(), re.S))
    if not declared:
        return []
    have = _css_rules(styles)
    # Contradiction-only. A style file's css block carries both the scaffold and
    # example components, so a document that omits a selector is not wrong — it
    # simply has no links, or no comparison rows. A document that *redefines* one
    # with a different value is contradicting the contract it selected, which is
    # the drift worth catching (a 56px h2 margin where the style says 40px).
    errors = []
    for sel, props in declared.items():
        if sel not in have:
            continue
        for k, v in props.items():
            got = have[sel].get(k)
            if got is None:
                continue
            if k == "font-family":
                # An abbreviated fallback stack is a simplification, not a
                # contradiction. What matters is that the document did not swap
                # the register — a serif style rendered in a sans. Sharing one
                # family is enough to show it kept the intent.
                fams = lambda s: {f.strip().strip("'\"").lower() for f in s.split(",")}
                if fams(got) & fams(v):
                    continue
            if _norm(got) != _norm(v):
                errors.append("'%s' sets %s: %s - the '%s' style says %s" % (sel, k, got, style, v))
    return errors


def _attr(tag, name, default=0.0):
    m = re.search(r'\b%s="([-\d.]+)"' % name, tag)
    return float(m.group(1)) if m else default


# Shapes whose extents this parser can compute exactly. A figure containing
# anything else — a <path>, a <use>, an <image> — has geometry we cannot read,
# so the inset check skips it rather than guessing. Overflow is still checked
# from whatever shapes are present, which is how it has always behaved.
_OPAQUE_TAGS = ("<path", "<use", "<image", "<foreignObject", "<textPath")


def _points_x(tag):
    m = re.search(r'points="([^"]+)"', tag)
    if not m:
        return []
    nums = [float(n) for n in re.findall(r"-?\d+(?:\.\d+)?", m.group(1))]
    return nums[0::2]


def _svg_faults(html):
    """Measure every figure once; the caller decides which faults it cares about.

    Returns (clipping, inset). Clipping is a defect in any house style — the
    drawing is cut off. Inset is taste: a viewBox larger than its ink indents
    the figure against the prose column, which matters when tdoc is the author
    and is none of its business when somebody else's agent is.
    """
    clipping = []
    inset = []
    for m in re.finditer(
        r'<svg[^>]*viewBox="\s*(-?[\d.]+)[\s,]+(-?[\d.]+)[\s,]+([\d.]+)[\s,]+([\d.]+)\s*"(.*?)</svg>',
        html, re.S,
    ):
        vx, vy, vw, vh = (float(m.group(i)) for i in range(1, 5))
        body = m.group(5)
        label = re.search(r'aria-label="([^"]*)"', m.group(0))
        name = label.group(1)[:44] if label else "unlabelled figure"
        tr = re.search(r'<g transform="translate\(([-\d.]+),\s*([-\d.]+)\)"', body)
        ox, oy = (float(tr.group(1)), float(tr.group(2))) if tr else (0.0, 0.0)

        xs, ys = [], []
        for r in re.finditer(r"<rect[^>]*>", body):
            tag = r.group(0)
            x, y = _attr(tag, "x"), _attr(tag, "y")
            xs += [x, x + _attr(tag, "width")]
            ys += [y, y + _attr(tag, "height")]
        for c in re.finditer(r"<circle[^>]*>", body):
            tag = c.group(0)
            cx, cy, rr = _attr(tag, "cx"), _attr(tag, "cy"), _attr(tag, "r")
            xs += [cx - rr, cx + rr]
            ys += [cy - rr, cy + rr]
        for L in re.finditer(r"<line[^>]*>", body):
            tag = L.group(0)
            xs += [_attr(tag, "x1"), _attr(tag, "x2")]
            ys += [_attr(tag, "y1"), _attr(tag, "y2")]
        for poly in re.finditer(r"<(?:polyline|polygon)[^>]*>", body):
            xs += _points_x(poly.group(0))

        if not xs:
            continue
        mx, my = max(xs) + ox, (max(ys) + oy if ys else 0.0)
        if mx > vx + vw + 0.5:
            clipping.append("figure '%s' overflows its viewBox by %dpx across" % (name, round(mx - vx - vw)))
        if ys and my > vy + vh + 0.5:
            clipping.append("figure '%s' overflows its viewBox by %dpx down" % (name, round(my - vy - vh)))

        # A <text> without an explicit anchor starts at its x, so it bounds the
        # ink on the left. text-anchor="middle" or "end" puts glyphs left of x,
        # which we cannot measure, so those figures opt out of the inset check.
        if any(t in body for t in _OPAQUE_TAGS) or 'text-anchor=' in body:
            continue
        for t in re.finditer(r"<text[^>]*>", body):
            xs.append(_attr(t.group(0), "x"))
        left = (min(xs) + ox) - vx
        if left > vw * 0.10:
            inset.append(
                "figure '%s' starts %d%% inside its own viewBox; set the viewBox to the "
                "drawing's bounds so the figure lines up with the text column"
                % (name, round(100 * left / vw))
            )
    return clipping, inset


def check_style_accent(html, style):
    """A page of figures using none of the style's accent is the style unapplied."""
    accents = STYLE_ACCENTS.get(style, ())
    if not accents:
        return []
    svgs = re.findall(r"<svg[^>]*>.*?</svg>", html, re.S)
    if len(svgs) < 2:
        return []
    low = html.lower()
    if any(a in low for a in accents):
        return []
    return ["%d figures and not one uses the '%s' style accent - the diagram "
            "vocabulary is not being applied" % (len(svgs), style)]


def check_table_cells(html, styles):
    """A cell that never names its fill or its radius inherits a chip.

    The reader stamps `background` and `border-radius` onto every th and td at
    zero specificity. Those survive a document rule that sets only borders and
    padding, so a table written that way renders as a grid of rounded tinted
    blocks whatever the style says. Nothing about the document reveals this —
    it looks correct in the source and wrong on the page — which is why it is
    checked rather than left to prose.

    A document with no table has nothing to reset.
    """
    if not re.search(r"<table[\s>]", html, re.I):
        return []
    css = "\n".join(styles)
    faults = []
    for prop in ("background", "border-radius"):
        # Any rule naming a cell and that property counts, in shorthand or long
        # form: `background:` also matches `background-color:`, and a document
        # is free to name them in one rule or several.
        hit = re.search(
            r"[^{}]*\b(?:th|td)\b[^{}]*\{[^}]*(?<![\w-])" + prop + r"[-\w]*\s*:",
            css, re.I | re.S)
        if not hit:
            faults.append(prop)
    if not faults:
        return []
    return ["a table's cells never set %s, so the reader's chip (a fill and an "
            "8px radius on every th and td) survives - name it on th, td" %
            " or ".join(faults)]


# A cell that refuses to wrap is a promise about its own length. Past this
# many characters it is prose, and the promise is a table that cannot fit.
CELL_PROSE_LIMIT = 32


# A rule styling generated content is not styling the cell.
PSEUDO_ELEMENT = re.compile(r"::|:(?:before|after|first-line|first-letter)\b", re.I)


def _cell_target(selector):
    """What a rule finally styles: (classes worn by that element, its tag).

    Only the last compound counts. `.tablewrap td.lbl` styles a cell wearing
    `.lbl`; `.tablewrap td` styles cells generally and `.tablewrap` is an
    ancestor, not something a cell wears. A class inside `:not()` is the
    opposite of worn, so pseudo-class arguments are dropped before the classes
    are read, and a `::before` rule is dropped entirely.
    """
    selector = re.sub(r"\s+", " ", selector.strip().lower())
    if PSEUDO_ELEMENT.search(selector):
        return None
    # Collapse arguments so a space inside :not(...) cannot split a compound.
    last = _last_compound(re.sub(r"\([^()]*\)", "()", selector))
    if ":" in last:
        # A structural pseudo-class picks a subset of the cells - :first-child
        # is the first column, not the table. Which cells that is cannot be
        # read off the markup by class, and a check that stops a publish must
        # not guess, so the rule is left unjudged.
        return None
    tag = re.match(r"^([a-z][-\w]*)", last)
    return re.findall(r"\.([A-Za-z_][-\w]*)", last), (tag.group(1) if tag else "")


def _attr_classes(attrs):
    found = re.search(r"""class\s*=\s*("([^"]*)"|'([^']*)')""", attrs, re.I)
    if not found:
        return []
    return (found.group(2) or found.group(3) or "").split()


def _last_compound(selector):
    parts = re.split(r"[\s>+~]+", re.sub(r"\s+", " ", selector.strip().lower()))
    return parts[-1] if parts else ""


def _unconditional_css(css):
    """The rules that always apply — every at-rule block removed, braces balanced.

    A size inside `@media` is a different layout, not a second size in the same
    one: a table that becomes a stack of cards on a phone is entitled to set
    its label apart. Only what the document says unconditionally is judged.
    """
    out, i, length = [], 0, len(css)
    while i < length:
        at = css.find("@", i)
        if at < 0:
            out.append(css[i:])
            break
        brace = css.find("{", at)
        semi = css.find(";", at)
        if brace < 0 or (0 <= semi < brace):
            # A statement at-rule (@import, @charset) ends at the semicolon.
            out.append(css[i:at])
            i = (semi + 1) if semi >= 0 else length
            continue
        out.append(css[i:at])
        depth, j = 0, brace
        while j < length:
            if css[j] == "{":
                depth += 1
            elif css[j] == "}":
                depth -= 1
                if depth == 0:
                    break
            j += 1
        i = j + 1
    return "".join(out)


def _cell_type_sizes(styles):
    """What size the document gives a body cell, and by which class.

    `base` is the size the document states for its BODY cells — the last
    declaration whose selector ends in a bare table or td. A bare `th` is
    excluded on purpose: `thead th` carries the label register by design, and
    reading it as the body size would compare every cell against the header. `by_class` is every
    size a class puts on top of it. A document that states no base is not
    judged: the reader owns the table's size and the document has not claimed
    otherwise.
    """
    base = None
    by_class = {}
    refuses_to_wrap = set()
    for raw_css in styles:
        css = _unconditional_css(re.sub(r"/\*.*?\*/", "", raw_css, flags=re.S))
        for match in re.finditer(r"([^{}]+)\{([^{}]*)\}", css, flags=re.S):
            selector_group, body = match.groups()
            declarations = split_declarations(body)
            size = next(
                (compact_css_value(value) for prop, value in declarations
                 if prop == "font-size"),
                None,
            )
            nowrap = any(
                prop == "white-space" and "nowrap" in value
                for prop, value in declarations
            )
            if size is None and not nowrap:
                continue
            for selector in selector_group.split(","):
                target = _cell_target(selector)
                if target is None:
                    continue
                names, tag = target
                if names:
                    if size is not None:
                        for name in names:
                            by_class[name] = size
                    if nowrap:
                        refuses_to_wrap.update(names)
                elif tag in {"table", "td"}:
                    if size is not None:
                        base = size
                    if nowrap:
                        # An unqualified nowrap on every cell is the same
                        # promise, made about the whole table.
                        refuses_to_wrap.add("")
    return base, by_class, refuses_to_wrap


def _longest_cell_per_class(html):
    """class -> (length, text) of the longest th/td wearing it.

    "" holds the longest cell in the document whatever it wears, which is what
    an unqualified th/td rule is making its promise about.
    """
    longest = {}
    for match in re.finditer(r"<(t[hd])\b([^>]*)>(.*?)</\1\s*>", html, re.I | re.S):
        text = unescape(re.sub(r"<[^>]+>", "", match.group(3)))
        text = re.sub(r"\s+", " ", text).strip()
        for name in _attr_classes(match.group(2)) + [""]:
            if len(text) > longest.get(name, (-1, ""))[0]:
                longest[name] = (len(text), text)
    return longest


def check_table_cell_type(html, styles):
    """A table's body is one type size, and only a short value refuses to wrap.

    Both failures come from one habit: a class written for numerals — smaller,
    monospaced, `white-space: nowrap` — applied to the whole `<td>` rather than
    to the numerals inside it. When the cells it lands on hold sentences, two
    things break at once.

    The column it styles is set in a different size from its neighbours, so a
    reader scanning across sees the type change size mid-row; and if the face
    is monospaced it carries no CJK, so the same script renders at two sizes
    one column apart. That is not a house-style preference — nothing in the
    document says a table should have two type sizes, and the author reading
    the source cannot see that it does.

    `nowrap` on prose is worse than untidy: the cell can never break, so the
    table takes a width no viewport can give it and pushes the whole page
    sideways. `READER_PATCH_CSS` rescues that from the reader's side below
    700px by making the table scroll itself; the cause is here.

    A numeric column set in mono is a real convention and stays legal — put it
    on the numerals (`<span>`), or change only what tabular figures need
    (`font-variant-numeric`), which costs no size and no glyph coverage.

    Judged on both paths. A table too wide to read is broken whoever wrote it,
    and the document that showed this brings its own design system.
    """
    if not re.search(r"<table[\s>]", html, re.I):
        return []
    base, by_class, refuses_to_wrap = _cell_type_sizes(styles)
    longest = _longest_cell_per_class(html)
    errors = []

    def offender(name):
        """The longest cell wearing this class, if it is prose."""
        length, text = longest.get(name, (0, ""))
        return (length, text) if length > CELL_PROSE_LIMIT else None

    for name in sorted(by_class):
        size = by_class[name]
        if base is None or size == base:
            continue
        prose = offender(name)
        if not prose:
            continue
        errors.append(
            "'.%s' sets %s where the table's cells are %s, and it sits on a "
            "%d-character cell (\"%s…\") — a size on a cell class is a claim "
            "that the cell is short; on prose it gives one column a different "
            "size from its neighbours"
            % (name, size, base, prose[0], prose[1][:40])
        )

    for name in sorted(refuses_to_wrap):
        prose = offender(name)
        if not prose:
            continue
        errors.append(
            "%s sets white-space: nowrap but sits on a %d-character cell "
            "(\"%s…\") — nowrap says a cell is short; on prose it gives the "
            "table a width no viewport can hold"
            % ("a th/td rule" if name == "" else "'.%s'" % name,
               prose[0], prose[1][:40])
        )
    return errors


def check_figure_width(html, styles):
    """A figure that never states its width is sized by the page, not the doc.

    An <svg width="960"> renders at 960 physical pixels. The reader currently
    caps it with `max-width: 100% !important`, so it looks right when tdoc
    serves it and overflows the moment it is read anywhere else - the wrapper
    scrolls the last panel out of sight and nothing on screen says so.

    Only figures inside a scroll wrapper are judged. An inline glyph sized by
    its own attributes is not a figure and has nothing to declare.
    """
    if not re.search(r'class="[^"]*\bdiagram-box\b', html, re.I):
        return []
    # A figure with no intrinsic width is already fluid.
    if not re.search(r"<svg[^>]*\bwidth=", html, re.I):
        return []
    css = "\n".join(styles)
    if re.search(r"[^{}]*\bsvg\b[^{}]*\{[^}]*(?<![\w-])(?:width|min-width)\s*:", css, re.I | re.S):
        return []
    return ["a figure in a scroll wrapper carries a pixel width but no CSS "
            "width, so it is sized by the reader rather than by the document - "
            "set width:100% (and a min-width only if it should scroll)"]


# `transparent`, `none` and a zero-alpha color all composite over whatever the
# reader paints behind the frame, which is the thing an explicit ground exists
# to prevent.
def is_transparent(value: str) -> bool:
    v = compact_css_value(value)
    if v in {"transparent", "none", "initial", "unset"}:
        return True
    m = re.match(r"(?:rgba?|hsla?|hwb|lab|lch|oklab|oklch|color)\(([^)]*)\)$", v)
    if m:
        inner = m.group(1)
        # Both syntaxes carry alpha last: the legacy comma form as a fourth
        # argument, the modern form after a slash.
        alpha = inner.split("/")[1] if "/" in inner else None
        if alpha is None:
            parts = [p.strip() for p in inner.split(",")]
            alpha = parts[3] if len(parts) == 4 else None
        if alpha is not None:
            try:
                return float(alpha.strip().rstrip("%")) == 0
            except ValueError:
                return False
    return False


def validate(path: Path, *, style: str, custom_template: bool) -> tuple[list[str], list[str]]:
    """Return (errors, notes).

    Two different kinds of judgment used to share one exit code, and the split
    matters more than it looks. ERRORS are the things that break the system:
    markup that is inert under CSP, a missing viewport, a content root the
    probe cannot measure, a figure that overflows the column. NOTES are taste:
    which background the house style picked, whether a component's margin is
    the one the style entry documents, whether the selectors are scoped the way
    tdoc scopes its own.

    Enforcing taste is the wrong shape for this tool. A document is allowed to
    bring its own design — the reading template is :where() zero-specificity
    precisely so the author wins — so a house-style deviation is worth saying
    out loud and not worth refusing to create the document over. Before the
    split this file rejected a `.note` whose margin was 22px where the style
    said 20px, while passing a 1100px-wide inner container.
    """
    html = path.read_text(encoding="utf-8")
    parser = ContractParser()
    parser.feed(html)
    errors: list[str] = []
    notes: list[str] = []

    if not parser.has_viewport:
        errors.append('missing <meta name="viewport">')
    if parser.primary_roots != 1:
        errors.append("expected exactly one direct body content root (.wrap, main, article, .content, or .container)")
    # Only when a root exists. A doc with no root at all is a supported shape —
    # the template applies the column to body itself via :has() — and its
    # headings are not "escaped", they are the document.
    if parser.primary_roots >= 1 and parser.stray_body_children:
        kinds = ", ".join(f"<{t}>" for t in sorted(set(parser.stray_body_children))[:6])
        errors.append(
            "%d element(s) sit outside the content root (%s); the reading column does not "
            "apply to them. One unbalanced </div> closing the root early is the usual cause"
            % (len(parser.stray_body_children), kinds)
        )
    if parser.has_footer:
        errors.append("author <footer> is reserved; the tdoc shell supplies the footer")
    if parser.author_scripts:
        errors.append("host <script> is inert under CSP; move JavaScript to v<n>/widgets/<name>.html")
    if parser.event_handlers:
        errors.append("host on*= event handlers are inert under CSP: " + ", ".join(parser.event_handlers))
    if parser.javascript_urls:
        errors.append("host javascript: URLs are inert under CSP: " + ", ".join(parser.javascript_urls))
    if parser.host_canvas:
        errors.append("host <canvas> cannot render without JavaScript; use SVG or a sandboxed widget island")
    if parser.inline_prose_styles and not custom_template:
        tags = ", ".join(sorted(set(parser.inline_prose_styles)))
        notes.append(f"inline styles override default prose elements: {tags}")

    # Clipping is measured on both paths. A drawing cut off by its own viewBox
    # is broken whoever wrote it; the house style has no opinion about it. The
    # inset check is the taste half and stays below the return.
    raw_html = path.read_text(encoding="utf-8", errors="replace")
    clipping, inset = _svg_faults(raw_html)
    errors.extend(clipping)
    # Measured on both paths, for the same reason clipping is: a table
    # wider than any viewport is broken whoever designed it, and the house
    # style has no opinion about how many sizes a table's body has.
    errors.extend(check_table_cell_type(raw_html, parser.styles))

    if custom_template:
        return errors, notes

    body_background = False
    for raw_css in parser.styles:
        css = re.sub(r"/\*.*?\*/", "", raw_css, flags=re.S)
        for match in re.finditer(r"([^{}]+)\{([^{}]*)\}", css, flags=re.S):
            selector_group, declarations_raw = match.groups()
            if selector_group.strip().startswith("@"):
                continue
            declarations = split_declarations(declarations_raw)
            for selector in selector_group.split(","):
                normalized = re.sub(r"\s+", " ", selector.strip().lower())
                if normalized == "body":
                    allowed = all(prop in {"background", "background-color"} for prop, _ in declarations)
                    white = any(
                        prop in {"background", "background-color"}
                        and compact_css_value(value) in HOUSE_BACKGROUNDS[style]
                        for prop, value in declarations
                    )
                    # Structural, so it reads the VALUE: an explicitly
                    # transparent ground is the exact failure the error names,
                    # and checking only the property name would pass it while
                    # failing the document that merely omits the property.
                    if any(
                        prop in {"background", "background-color"}
                        and not is_transparent(value)
                        for prop, value in declarations
                    ):
                        body_background = True
                    if not (allowed and white):
                        notes.append(f"body background does not match the '{style}' house style")
                elif normalized in {".wrap", ".content", ".container", "main", "article"}:
                    forbidden = sorted({prop for prop, _ in declarations}.intersection(ROOT_LAYOUT_PROPERTIES))
                    if forbidden:
                        errors.append(
                            f"content root selector '{selector.strip()}' overrides reader layout: "
                            + ", ".join(forbidden)
                        )
                elif selector_is_global(normalized):
                    notes.append(f"global selector '{selector.strip()}' overrides the default template")

    if not body_background:
        # An explicit ground is structural: without it the page composites over
        # whatever the reader is painting behind it.
        errors.append(
            "body sets no opaque background; the page composites over the reader's "
            "own ground (an omitted property and an explicit transparent/none/"
            "zero-alpha value are the same failure)"
        )
    raw = raw_html
    notes.extend(check_style_contract(parser.styles, style))
    # Figure alignment is a house-style judgment, not a correctness one, so it
    # only applies where tdoc is the author. An agent bringing its own design
    # system reaches this file through --custom-template and returned above.
    # A figure whose ink starts inside its own box reads as indented against
    # every paragraph around it — a defect the reader sees, not a house-style
    # preference, and visuals.md documents it as a failure.
    errors.extend(inset)
    notes.extend(check_style_accent(raw, style))
    # The cell reset is a house-style rule: tdoc tables are ruled, never filled.
    # A caller bringing its own design system returned above with the other
    # house checks, so this only judges documents tdoc itself authored.
    notes.extend(check_table_cells(raw, parser.styles))
    # A figure that states a pixel width but no CSS width overflows the column
    # wherever the reader CSS is not doing the capping (#320) — correctness.
    errors.extend(check_figure_width(raw, parser.styles))

    return errors, notes


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate tdoc default-template author HTML")
    parser.add_argument("html_file")
    parser.add_argument("--style", choices=sorted(HOUSE_STYLES), default="default")
    parser.add_argument("--custom-template", action="store_true", help="explicitly allow a custom whole-page design")
    parser.add_argument("--strict", action="store_true", help="fail on house-style notes as well as errors (CI)")
    args = parser.parse_args()
    path = Path(args.html_file)
    if not path.is_file():
        print(f"tdoc-template: file not found: {path}", file=sys.stderr)
        return 2
    errors, notes = validate(path, style=args.style, custom_template=args.custom_template)
    if notes:
        print(f"tdoc-template: {len(notes)} house-style note(s) — the document is still valid:", file=sys.stderr)
        for note in notes:
            print(f"  · {note}", file=sys.stderr)
        print("These are taste, not contract. Follow them for a document that matches", file=sys.stderr)
        print("the house style; ignore them for one that deliberately brings its own.", file=sys.stderr)
    if errors:
        print("tdoc-template: the document would not render correctly:", file=sys.stderr)
        for error in errors:
            print(f"  - {error}", file=sys.stderr)
        print("Keep host HTML static/CSS-only. Put computation in a sandboxed widget island.", file=sys.stderr)
        return 1
    if notes and args.strict:
        print("tdoc-template: --strict, so notes fail the run.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

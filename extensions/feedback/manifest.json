{
  "manifest_version": 3,
  "name": "tdoc Feedback",
  "version": "0.1.0",
  "description": "Point at any UI, leave contextual feedback, and hand it directly to a person or agent.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*/*"],
  "action": {
    "default_title": "Toggle tdoc Feedback"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-feedback": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Toggle feedback mode"
    }
  },
  "options_page": "options.html"
}

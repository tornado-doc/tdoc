name = "tdoc"
main = "_worker.bundled.js"
compatibility_date = "2025-01-01"
workers_dev = true

# Workers Logs: persisted, searchable invocation logs in the Cloudflare
# dashboard (Workers > tdoc > Logs), with sampled traces. Without this the
# only view into a live worker is `wrangler tail`, which shows nothing that
# happened before you attached — so a 500 reported after the fact could only
# be chased by reproducing it. head_sampling_rate = 1 keeps every invocation;
# lower it if request volume ever makes the included quota the binding cost.
[observability]
enabled = true
head_sampling_rate = 1

# Aggregate product counters live separately from request logs so they can be
# queried over time without parsing log lines. The dataset is created on the
# first write; no per-user or per-document identifier is written to it.
[[analytics_engine_datasets]]
binding = "PRODUCT_ANALYTICS"
dataset = "tdoc_product_events"

# Trash: deleted docs wait 30 days, then the scheduled handler erases them
# (purgeExpiredTrash, a bounded batch per run, so hourly keeps up).
[triggers]
crons = ["23 * * * *"]

[[r2_buckets]]
binding = "DOCS"
bucket_name = "tdoc-docs"

[[kv_namespaces]]
binding = "META"
id = "PLACEHOLDER_KV_ID"

# Team/Pro Data Mirror. Publishing stays on the request path; customer-owned
# S3/R2 backup writes happen here with retries and a dead-letter queue, so a
# destination outage cannot break tdoc. CD creates both queues idempotently.
[[queues.producers]]
binding = "BACKUP_QUEUE"
queue = "tdoc-backups"

[[queues.consumers]]
queue = "tdoc-backups"
max_batch_size = 1
max_batch_timeout = 5
max_retries = 10
dead_letter_queue = "tdoc-backups-dlq"

# Invitation emails need ONE of two delivery plugs, and BOTH are optional —
# with neither, the worker sends nothing and invitations stay in-app only:
#   - Secret: RESEND_API_KEY (`wrangler secret put RESEND_API_KEY`) sends
#     through Resend's HTTPS API; verify your sending domain there first.
#   - Or Cloudflare Email Sending (Workers Paid + `wrangler email sending
#     enable <your-domain>`): uncomment the binding below; it wins over the
#     Resend key when both exist.
# The from address defaults to invites@<request host>; override with
# TDOC_EMAIL_FROM.
# [[send_email]]
# name = "EMAIL"

# Per-slug write serialization (#34). All comment mutations for one slug funnel
# through one CommentsStore instance (idFromName(slug)), which Cloudflare runs
# single-threaded — so get→mutate→put can't overlap and concurrent writers
# can't clobber each other. The DO uses the SAME META KV for storage (no data
# migration); it's purely a serialization gate. If this binding is removed the
# worker falls back to direct KV writes (functional, just not serialized).
[[durable_objects.bindings]]
name = "COMMENTS"
class_name = "CommentsStore"

[[migrations]]
tag = "v1-comments-do"
new_sqlite_classes = ["CommentsStore"]

[vars]
OIDC_ISSUER = "https://clerk.tdoc.dev"
OIDC_CLIENT_ID = "qKJaxWEoECYonmld"
OIDC_LABEL = "Email"
# Filled from shared/github-oauth.js (single source of truth). Keep in sync —
# test/no-drift.test.js fails if this drifts from the SoT module.
GITHUB_CLIENT_ID = "Ov23li1jJiBkS23x4O07"

# The worker operator's GitHub login. On BYOK (hosted registration unset),
# only this signed-in viewer sees /me. On tdoc.dev, /me is per signed-in user;
# TDOC_OWNER still owns legacy docs with no hosted.github_login.
TDOC_OWNER = "PLACEHOLDER_OWNER"

# Who may put their OWN onboarding record into a named state, for internal
# testing. Comma-separated emails; empty allows nobody, which is every
# deploy's default.
#
# A variable, not a secret: an email is not a credential, and this list is
# read by people who need to change it, not guarded from them. And a variable
# rather than only KV, because the KV key can only be written by somebody
# holding Cloudflare credentials -- which made "let another tester in" a
# terminal session for one person instead of a field on a settings page.
# The KV key still works and is still additive, for when a change has to land
# without waiting for a deploy.
TDOC_DEBUG_ACCOUNTS = "PLACEHOLDER_DEBUG_ACCOUNTS"

# Raft App installations tdoc cannot learn from Connect with Raft yet, as
# { "<Raft server id or slug>": "<installation id>" }. An installation id is
# shown on the App's settings page and is not a credential: listing a
# server's agents still needs RAFT_CLIENT_ID/SECRET and the Agent permission
# that server approved. Today: the App owner's own server ("julie").
RAFT_INSTALLATION_IDS = '{"1ed923e0-27a4-47ff-b09a-ea27efe06877":"b3177b35-c920-4960-b459-b7de83086812"}'

# Ask this doc (free AI answers for signed-in readers without an agent):
#   Secret: ASK_API_KEY — `wrangler secret put ASK_API_KEY`. Unset = the
#   feature is off: the endpoint answers 503 and the doc page hides the entry.
#   Optional vars: ASK_API_BASE (any OpenAI-compatible base, default
#   https://openrouter.ai/api/v1), ASK_MODEL (default anthropic/claude-haiku-5.5),
#   ASK_FREE_LIMIT (questions per account, ever; default 5), ASK_MAX_TOKENS
#   (default 4500).
# Secret: TDOC_UPLOAD_TOKEN — set via `wrangler secret put TDOC_UPLOAD_TOKEN`
# Secret (recommended): TDOC_DATA_MIRROR_KEY — stable high-entropy key used
# only to encrypt customer S3 credentials in KV. Existing installs fall back
# to TDOC_UPLOAD_TOKEN so a deploy never silently disables configured mirrors.
# Secret: GITHUB_CLIENT_SECRET — set via `wrangler secret put GITHUB_CLIENT_SECRET`.
#   The web OAuth redirect flow (browsers) needs it to exchange the code for a
#   token; generate it on the SAME OAuth App as GITHUB_CLIENT_ID above, and set
#   that App's Authorization callback URL to https://<host>/auth/github/callback.
#   Leave unset to keep the device-code flow (no browser redirect).
# TDOC_HOSTED_REGISTRATION — leave unset on BYOK so /me stays single-owner.
# Unset + hostname https://tdoc.dev enables hosted signup; set to "1" to force
# on for every hostname on this Worker; "0" forces off. The tdoc.dev CD bundle
# (generated_by=tdoc-cd) also enables hosted /me on every hostname it serves,
# so friends hitting the workers_dev preview host are not bounced to the BYOK
# "worker operator" toast.
# The OIDC provider seat. Values below are hosted tdoc.dev's (Clerk, used
# strictly as an OIDC provider — never as a session layer, so replacing it is
# three values and no data migration). A BYOK deploy that wants its own
# provider swaps them; leaving them empty is also fine, and GitHub carries
# sign-in exactly as before.
# Secret: OIDC_CLIENT_SECRET — `wrangler secret put OIDC_CLIENT_SECRET`.
#   The issuer must accept https://<host>/auth/oidc/callback as a redirect URI.
# Team plan billing (#48). Off until the key and both prices are set: a
# deploy without them has no doc limit and shows no plan card. Members are
# always free; a free team holds 80 docs (TDOC_TEAM_FREE_DOCS overrides). The Team plan (unlimited docs, Data
# backup) bills every admin and member per seat.
# Secret: STRIPE_SECRET_KEY      — `wrangler secret put STRIPE_SECRET_KEY` (sk_live_… / rk_live_…)
# Secret: STRIPE_PRICE_MONTHLY   — the $5 / seat / month recurring Price id (price_…)
# Secret: STRIPE_PRICE_YEARLY    — the $50 / seat / year recurring Price id (price_…)
# Secret: STRIPE_WEBHOOK_SECRET  — signing secret (whsec_…) of a Stripe webhook endpoint at
#   https://<host>/api/stripe/webhook listening for checkout.session.completed and
#   customer.subscription.created / .updated / .deleted.
# Enable the Customer Portal in Stripe (Settings → Billing → Customer portal) so
# admins can change cards, switch period and cancel.
# AppSumo lifetime licenses (#61). Off until all three are set. Tier 1 / 2 / 3
# covers 5 / 15 / 40 seats (APPSUMO_TIER_SEATS). In the AppSumo Partner Portal:
#   Webhook URL        https://<host>/api/appsumo/webhook
#   OAuth Redirect URL https://<host>/appsumo/activate
# Secret: APPSUMO_API_KEY        — the product's Licensing API key; also signs webhooks
# Secret: APPSUMO_CLIENT_ID      — OAuth client id, shown once both URLs validate
# Secret: APPSUMO_CLIENT_SECRET  — OAuth client secret

[[rules]]
type = "CompiledWasm"
globs = ["**/*.wasm"]
fallthrough = true

[[rules]]
type = "Data"
globs = ["**/*.ttf"]
fallthrough = true

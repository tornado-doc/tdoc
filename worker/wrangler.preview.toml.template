# Preview Worker for PR published-chrome checks (#148).
# Separate from production `tdoc` / tdoc.dev. Own KV + R2. No Durable Object
# (Cloudflare will not mint preview URLs for a Worker that implements a DO).
#
# Materialize: replace PLACEHOLDER_PREVIEW_KV_ID, then:
#   TDOC_PREVIEW=1 node bin/tdoc-bundle
#   wrangler deploy -c worker/wrangler.preview.toml
#
# Do not bind tdoc-docs or the production META namespace.
# Preview URLs cannot consume Queues; leave PREVIEW_QUEUE unbound so a PR
# preview never sends work to another version's consumer. Cards use the logo.

name = "tdoc-preview"
main = "_worker.bundled.js"
compatibility_date = "2025-01-01"
workers_dev = true
preview_urls = true

# Workers Logs: persisted, searchable invocation logs in the Cloudflare
# dashboard (Workers > tdoc > Logs), with sampled traces. Without this the
# only view into a live worker is `wrangler tail`, which shows nothing that
# happened before you attached — so a 500 reported after the fact could only
# be chased by reproducing it. head_sampling_rate = 1 keeps every invocation;
# lower it if request volume ever makes the included quota the binding cost.
[observability]
enabled = true
head_sampling_rate = 1

# Keep preview traffic out of the production product counters.
[[analytics_engine_datasets]]
binding = "PRODUCT_ANALYTICS"
dataset = "tdoc_preview_product_events"

[[r2_buckets]]
binding = "DOCS"
bucket_name = "tdoc-preview-docs"

[[kv_namespaces]]
binding = "META"
id = "PLACEHOLDER_PREVIEW_KV_ID"

[vars]
GITHUB_CLIENT_ID = "Ov23liZ1UAGOchvKPmlS"
# Preview mirrors hosted tdoc.dev enough to review multi-tenant surfaces
# (/me claim handle, /@profiles, per-account catalogs). Still no Durable
# Object (Cloudflare preview URL limit) — comments use the KV fallback.
TDOC_OWNER = "yayashuxue"
TDOC_HOSTED_REGISTRATION = "1"
# KV writes get a 14-day TTL in worker.js when this is "1".
# R2 objects expire via the bucket lifecycle rule expire-preview-14d.
TDOC_PREVIEW = "1"
# PREVIEW_OIDC_VARS

# To enable sign-in on PR previews, create a separate OAuth application in the
# existing Clerk instance (not the production tdoc OAuth client). Set the
# public Client ID as GitHub Actions variable TDOC_PREVIEW_OIDC_CLIENT_ID and
# its secret as GitHub Actions secret TDOC_PREVIEW_OIDC_CLIENT_SECRET. The
# preview workflow injects these vars and installs OIDC_CLIENT_SECRET only on
# tdoc-preview. Register only the stable callback
# https://tdoc-preview.jyshi1107.workers.dev/auth/oidc/callback in Clerk.
# A 60-second one-use ticket returns the session to the originating PR alias.

# Secret: TDOC_UPLOAD_TOKEN — preview-only; never the production token.
# Secret: GITHUB_CLIENT_SECRET — set via `wrangler secret put GITHUB_CLIENT_SECRET`
#   for the web OAuth redirect flow. Generate it on the SAME OAuth App as the
#   preview GITHUB_CLIENT_ID above, with callback URL
#   https://<preview-host>/auth/github/callback. Unset ⇒ device-code flow.

[[rules]]
type = "CompiledWasm"
globs = ["**/*.wasm"]
fallthrough = true

[[rules]]
type = "Data"
globs = ["**/*.ttf"]
fallthrough = true
